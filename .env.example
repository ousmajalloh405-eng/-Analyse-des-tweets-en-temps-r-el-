# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me_in_local_env
MONGO_DB=tweets
MONGO_COLLECTION=analyzed_tweets
MONGO_URI=mongodb://admin:change_me_in_local_env@localhost:27017/?authSource=admin

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=tweets_raw
KAFKA_TOPIC_ANALYZED=tweets_analyzed

# --- Twitter / X API (optionnel) ---
# Laisser vide pour utiliser le simulateur
TWITTER_BEARER_TOKEN=
TWITTER_KEYWORDS=data,engineering,spark

# --- Mode ---
PRODUCER_MODE=simulator      # simulator | twitter
SIMULATOR_RATE_PER_SEC=5

# --- Spark ---
SPARK_MASTER=spark://spark-master:7077
CHECKPOINT_DIR=/tmp/spark-checkpoints